#!/usr/bin/env bash
# bin/warden — entrypoint
#
# Requires root. This tool edits disk encryption config and can run
# destructive disk operations; requiring root up front (rather than
# elevating per-command) means privilege is a single, visible,
# consciously-granted precondition instead of a series of sudo prompts
# a person under time pressure clicks through without reading.
set -euo pipefail

WARDEN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=lib/core/log.sh
source "${WARDEN_ROOT}/lib/core/log.sh"
# shellcheck source=lib/core/exec.sh
source "${WARDEN_ROOT}/lib/core/exec.sh"
# shellcheck source=lib/core/device.sh
source "${WARDEN_ROOT}/lib/core/device.sh"
# shellcheck source=lib/core/confirm.sh
source "${WARDEN_ROOT}/lib/core/confirm.sh"
# shellcheck source=lib/core/backup.sh
source "${WARDEN_ROOT}/lib/core/backup.sh"
# shellcheck source=lib/core/pkg.sh
source "${WARDEN_ROOT}/lib/core/pkg.sh"
# shellcheck source=lib/core/net.sh
source "${WARDEN_ROOT}/lib/core/net.sh"
# shellcheck source=lib/core/crypt_inventory.sh
source "${WARDEN_ROOT}/lib/core/crypt_inventory.sh"
# shellcheck source=lib/tui/menu.sh
source "${WARDEN_ROOT}/lib/tui/menu.sh"
# shellcheck source=lib/features/install.sh
source "${WARDEN_ROOT}/lib/features/install.sh"
# shellcheck source=lib/features/status.sh
source "${WARDEN_ROOT}/lib/features/status.sh"
# shellcheck source=lib/features/tang_server.sh
source "${WARDEN_ROOT}/lib/features/tang_server.sh"
# shellcheck source=lib/features/tang_bindings.sh
source "${WARDEN_ROOT}/lib/features/tang_bindings.sh"
# shellcheck source=lib/features/zfs_pool.sh
source "${WARDEN_ROOT}/lib/features/zfs_pool.sh"
# shellcheck source=lib/features/luks_enroll.sh
source "${WARDEN_ROOT}/lib/features/luks_enroll.sh"
# shellcheck source=lib/features/luks_setup.sh
source "${WARDEN_ROOT}/lib/features/luks_setup.sh"
# shellcheck source=lib/features/lateboot.sh
source "${WARDEN_ROOT}/lib/features/lateboot.sh"
# shellcheck source=lib/features/binding_rotate.sh
source "${WARDEN_ROOT}/lib/features/binding_rotate.sh"
# shellcheck source=lib/features/header_backup.sh
source "${WARDEN_ROOT}/lib/features/header_backup.sh"
# shellcheck source=lib/features/tang_rotate.sh
source "${WARDEN_ROOT}/lib/features/tang_rotate.sh"
# shellcheck source=lib/features/danger_erase.sh
source "${WARDEN_ROOT}/lib/features/danger_erase.sh"
# shellcheck source=lib/features/uninstall.sh
source "${WARDEN_ROOT}/lib/features/uninstall.sh"

if [[ "${EUID}" -ne 0 ]]; then
    echo "warden: must be run as root (e.g. sudo warden). Refusing to elevate per-command." >&2
    exit 1
fi

log_init

MENU_TEXT="Day 0 / Day 1 / Maintenance / Danger Zone -- select an option:"

main_menu_loop() {
    local choice
    while true; do
        choice="$(whiptail --title "Warden -- NBDE Management" --cancel-button "Exit" --menu "$MENU_TEXT" 24 78 15 \
            1 "Install components (Tang / Clevis / both)" \
            2 "Configure Tang server" \
            3 "Tang servers to trust (bindings)" \
            4 "LUKS setup wizard" \
            5 "LUKS enrolment wizard" \
            6 "Enable/verify late-boot unlocker" \
            7 "Status dashboard" \
            8 "Add / remove / rotate a binding" \
            9 "Backup LUKS header(s)" \
            10 "Rotate Tang server keys" \
            11 "DANGER ZONE: Erase LUKS header" \
            12 "Uninstall / revert" \
            13 "Exit" \
            3>&1 1>&2 2>&3)" || exit 0

        case "$choice" in
            1) feature_install_menu ;;
            2) feature_tang_server_config ;;
            3) feature_tang_bindings_menu ;;
            4) feature_luks_setup_menu ;;
            5) feature_luks_enrol_menu ;;
            6) feature_lateboot_menu ;;
            8) feature_binding_rotate_menu ;;
            9) feature_header_backup_menu ;;
            10) feature_tang_key_rotate_menu ;;
            11) feature_danger_erase_menu ;;
            12) feature_uninstall_menu ;;
            7) feature_status_dashboard ;;
            13) exit 0 ;;
            *) warden_msg "Not yet implemented" "Menu item ${choice} is not yet implemented yet." ;;
        esac
    done
}

main_menu_loop
